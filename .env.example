# ─────────────────────────────────────────────────────────────────────────────
# Orange Salon — environment variables
# Copy to .env.local for development. In Vercel, add them under
# Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (canonical links, sitemap, emails). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Convex (written to .env.local by `npx convex dev`) ───────────────────────
# Development deployment used by `npx convex dev`. Not needed on Vercel, where
# the build uses CONVEX_DEPLOY_KEY instead (see docs/DEPLOYMENT.md).
CONVEX_DEPLOYMENT=
# The deployment's URL, e.g. https://happy-animal-123.convex.cloud. Safe in the browser.
NEXT_PUBLIC_CONVEX_URL=
# SERVER ONLY. Must equal the CONVEX_SERVER_SECRET set on the Convex deployment
# (`npx convex env set CONVEX_SERVER_SECRET …`). It lets this server — and only
# this server — call the booking API, rate limiter and notification log.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONVEX_SERVER_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────
# Encrypts the short-lived "view my booking" cookie. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_COOKIE_SECRET=
# Salt for hashing IPs/phones in rate-limit keys (any random string).
RATE_LIMIT_SALT=
# Protects /api/cron/reminders. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# ── Email via Resend (optional; without it emails are logged as "skipped") ───
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Orange Salon <bookings@yourdomain.com>"
EMAIL_FROM=

# ── WhatsApp Business Platform / Cloud API (optional) ────────────────────────
# Business-initiated messages need templates approved in Meta Business Manager.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Template names per event (leave blank to skip that event on WhatsApp).
# Body parameters: {{1}} name, {{2}} service, {{3}} date, {{4}} time, {{5}} reference
WHATSAPP_TEMPLATE_REQUESTED=
WHATSAPP_TEMPLATE_CONFIRMED=
WHATSAPP_TEMPLATE_RESCHEDULED=
WHATSAPP_TEMPLATE_CANCELLED=
WHATSAPP_TEMPLATE_REMINDER=

# ── Development only ─────────────────────────────────────────────────────────
# Show clearly labelled sample services/stylists when no Convex deployment is connected.
# Ignored on Vercel production deployments.
DEMO_CONTENT=false
